{
  "manifest_version": 3,
  "name": "Clatri",
  "version": "0.15.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "bank-transfer.html"
      ],
      "matches": [
        "https://*.bancolombia.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bancolombia.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.bancolombia.com/*"
      ],
      "js": [
        "src/core/shape.js",
        "src/core/registry.js",
        "src/banks/co-bancolombia.js",
        "src/core/engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.bancolombia.com/*"
      ],
      "js": [
        "src/core/i18n.js",
        "src/core/export.js",
        "src/ui/kit.js",
        "src/ui/panel.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://db.clatri.com/*",
    "https://api.clatri.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "__MSG_openClatri__"
  },
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors https://*.bancolombia.com;"
  }
}
